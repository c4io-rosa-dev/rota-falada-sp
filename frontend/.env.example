# Copie para .env.local. As duas de Supabase são públicas por desenho; sem elas, o login some e o resto funciona.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Provedor de tiles; o padrão é o do OpenStreetMap.
VITE_TILE_URL=
# E-mail público de suporte e de pedidos de exclusão de conta, exibido em /conta.
# Este endereço é só um exemplo, não é uma caixa de entrada do projeto.
VITE_CONTATO_PRIVACIDADE=rotafaladasp@gmail.com
